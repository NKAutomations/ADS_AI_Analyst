"""
ads_client.py - Read-only ADS-Client mit Notification-Unterstuetzung.
Kein Schreibzugriff. Kein Simulationsmodus.
"""
from __future__ import annotations

import logging
import threading
from datetime import datetime
from typing import Callable, Dict, List, Optional

logger = logging.getLogger(__name__)


def _import_pyads():
    from app.ads.dll_compat import prepare_pyads_import
    prepare_pyads_import()
    import pyads
    return pyads

_TYPE_MAP: Dict[str, str] = {
    "BOOL": "BOOL",
    "INT": "INT",
    "DINT": "DINT",
    "UINT": "UINT",
    "UDINT": "UDINT",
    "REAL": "REAL",
    "LREAL": "LREAL",
    "TIME": "TIME",
    "STRING": "STRING",
    "WORD": "UINT",
    "DWORD": "UDINT",
    "BYTE": "UINT",
    "SINT": "INT",
    "USINT": "UINT",
    "LINT": "DINT",
    "ULINT": "UDINT",
}

SUPPORTED_TYPES = set(_TYPE_MAP.keys())


def _normalize_type(tc_type: str):
    upper = tc_type.upper().strip()
    if upper.startswith("STRING"):
        return "STRING", True
    norm = _TYPE_MAP.get(upper)
    if norm:
        return norm, True
    return upper, False


class AdsSymbolInfo:
    def __init__(self, name: str, tc_type: str, comment: str = "") -> None:
        self.name = name
        self.tc_type = tc_type
        norm, supported = _normalize_type(tc_type)
        self.data_type = norm
        self.supported = supported
        self.comment = comment


def _get_pyads_type(data_type: str):
    try:
        pyads = _import_pyads()
        mapping = {
            "BOOL": pyads.PLCTYPE_BOOL,
            "INT": pyads.PLCTYPE_INT,
            "DINT": pyads.PLCTYPE_DINT,
            "UINT": pyads.PLCTYPE_UINT,
            "UDINT": pyads.PLCTYPE_UDINT,
            "REAL": pyads.PLCTYPE_REAL,
            "LREAL": pyads.PLCTYPE_LREAL,
            "TIME": pyads.PLCTYPE_UDINT,
            "STRING": pyads.PLCTYPE_STRING,
        }
        return mapping.get(data_type)
    except ImportError:
        return None


def _get_type_size(data_type: str) -> int:
    sizes = {
        "BOOL": 1, "INT": 2, "DINT": 4, "UINT": 2, "UDINT": 4,
        "REAL": 4, "LREAL": 8, "TIME": 4, "STRING": 81,
    }
    return sizes.get(data_type, 4)


class AdsClient:
    def __init__(
        self,
        host: str,
        ams_net_id: str,
        port: int = 851,
        timeout_seconds: float = 3.0,
        notification_cycle_ms: int = 100,
    ) -> None:
        self.host = host
        self.ams_net_id = ams_net_id
        self.port = port
        self.timeout_seconds = timeout_seconds
        self.notification_cycle_ms = notification_cycle_ms
        self._plc = None
        self._connected = False
        self._lock = threading.Lock()
        self._notification_handles: Dict[str, int] = {}
        self._notification_error_reported: set[str] = set()
        self.on_value_changed: Optional[Callable[[str, object, datetime], None]] = None
        self.on_error: Optional[Callable[[str], None]] = None

    def connect(self):
        try:
            pyads = _import_pyads()
        except ImportError:
            return False, "pyads ist nicht installiert."

        try:
            with self._lock:
                if self._plc is not None:
                    try:
                        self._plc.close()
                    except Exception:
                        pass
                plc = pyads.Connection(self.ams_net_id, self.port, self.host)
                plc.open()
                try:
                    device_info = plc.read_device_info()
                    state = plc.read_state()
                    device_name = device_info[0]
                    ads_state = state[0]
                    logger.info("ADS verifiziert: Geraet=%s ADS-State=%s", device_name, ads_state)
                except Exception as verify_err:
                    plc.close()
                    return (
                        False,
                        f"Verbindung geoeffnet, aber Verifikation fehlgeschlagen: {verify_err}\n"
                        "Bitte AMS Net ID, IP-Adresse und ADS-Route pruefen.",
                    )
                self._plc = plc
                self._connected = True
            return (
                True,
                f"ADS verifiziert - echte Runtime\nGeraet: {device_name} | ADS-State: {ads_state}",
            )
        except Exception as e:
            self._connected = False
            return False, f"Verbindungsfehler: {e}"

    def disconnect(self) -> None:
        with self._lock:
            self._stop_all_notifications_locked()
            if self._plc is not None:
                try:
                    self._plc.close()
                except Exception as e:
                    logger.warning("Fehler beim Schliessen: %s", e)
                self._plc = None
            self._connected = False
        logger.info("ADS-Verbindung getrennt")

    @property
    def connected(self) -> bool:
        return self._connected

    def read_all_symbols(self):
        with self._lock:
            if not self._connected or self._plc is None:
                return [], "Nicht verbunden."
            try:
                # pyads 3.2.2 besitzt noch keine Connection.get_all_symbols().
                # Der Symbol-Upload wird deshalb direkt ueber die offiziellen
                # ADS-Symbolupload-Indexgruppen gelesen.
                symbol_list = self._read_all_symbols_compat()
                logger.info("%d Symbole gelesen", len(symbol_list))
                return symbol_list, ""
            except Exception as e:
                logger.error("Fehler beim Lesen der Symbole: %s", e)
                return [], f"Fehler beim Lesen der Symbole: {e}"

    def _read_all_symbols_compat(self) -> list[AdsSymbolInfo]:
        """Symbolbrowser fuer pyads 3.2.2 ohne get_all_symbols()."""
        import struct
        from ctypes import create_string_buffer
        pyads = _import_pyads()
        # In pyads 3.2.2 werden die ADS-Konstanten nicht am Top-Level
        # exportiert, sondern unter pyads.constants.
        try:
            from pyads import constants as ads_constants
            upload_info_group = ads_constants.ADSIGRP_SYM_UPLOADINFO2
            upload_group = ads_constants.ADSIGRP_SYM_UPLOAD
            device_state_offset = ads_constants.ADSIOFFS_DEVDATA_ADSSTATE
        except (ImportError, AttributeError):
            # Werte aus der Beckhoff-ADS-Spezifikation als kompatibler Fallback.
            upload_info_group = 0xF00F
            upload_group = 0xF00B
            device_state_offset = 0

        info = self._plc.read(
            upload_info_group,
            device_state_offset,
            pyads.PLCTYPE_STRING,
            return_ctypes=True,
        )
        raw_info = bytes(info)
        if len(raw_info) < 8:
            raise RuntimeError("ADS-Symbolinfo ist kuerzer als 8 Bytes.")

        symbol_count, symbol_bytes = struct.unpack("<II", raw_info[:8])
        if symbol_count <= 0:
            return []
        if symbol_bytes <= 0 or symbol_bytes > 100 * 1024 * 1024:
            raise RuntimeError("Ungueltige ADS-Symbolliste: " + str(symbol_bytes) + " Bytes.")

        # read() akzeptiert in pyads eine ctypes-Factory fuer variable Payloads.
        payload_type = lambda n=symbol_bytes: create_string_buffer(n)
        payload = self._plc.read(
            upload_group,
            device_state_offset,
            payload_type,
            return_ctypes=True,
        )
        data = bytes(payload)
        result = []
        pos = 0

        for index in range(symbol_count):
            if pos + 30 > len(data):
                logger.warning("ADS-Symbolliste endet bei Eintrag %d/%d", index, symbol_count)
                break

            entry_size, index_group, index_offset = struct.unpack(
                "<III", data[pos:pos + 12]
            )
            name_len, type_len, comment_len = struct.unpack(
                "<HHH", data[pos + 24:pos + 30]
            )
            if entry_size < 30 or pos + entry_size > len(data):
                logger.warning("Ungueltige Symbolgroesse bei Eintrag %d: %d", index, entry_size)
                break

            name_start = pos + 30
            type_start = name_start + name_len + 1
            comment_start = type_start + type_len + 1
            name_raw = data[name_start:name_start + name_len]
            type_raw = data[type_start:type_start + type_len]
            comment_raw = data[comment_start:comment_start + comment_len]

            def decode_ads_text(value: bytes) -> str:
                value = value.split(b"\0", 1)[0]
                for encoding in ("utf-8", "cp1252", "latin-1"):
                    try:
                        return value.decode(encoding)
                    except UnicodeDecodeError:
                        pass
                return value.decode("latin-1", errors="replace")

            name = decode_ads_text(name_raw)
            tc_type = decode_ads_text(type_raw)
            comment = decode_ads_text(comment_raw)
            if name:
                result.append(AdsSymbolInfo(name=name, tc_type=tc_type, comment=comment))
            pos += entry_size

        return result

    def read_value(self, symbol: str, data_type: str):
        with self._lock:
            if not self._connected or self._plc is None:
                return None, False, "Nicht verbunden."
            try:
                plc_type = _get_pyads_type(data_type)
                if plc_type is None:
                    return None, False, f"Nicht unterstuetzter Typ: {data_type}"
                value = self._plc.read_by_name(symbol, plc_type)
                return value, True, ""
            except Exception as e:
                logger.warning("Lesefehler %s: %s", symbol, e)
                return None, False, str(e)

    def start_notification(self, symbol: str, data_type: str):
        with self._lock:
            if not self._connected or self._plc is None:
                return False, "Nicht verbunden."
            if symbol in self._notification_handles:
                return True, "Bereits registriert."
            # pyads 3.x dekodiert STRING-Notifications in der Standardroutine
            # als UTF-8. TwinCAT-STRING ist in vielen Projekten ANSI/Windows-1252.
            # Solche Notifications werden daher bewusst nicht registriert; ein
            # Initialwert kann weiterhin gelesen werden.
            if data_type == "STRING":
                return False, "STRING-Notifications deaktiviert (ANSI/UTF-8 unklar); Initialwert-Lesen weiterhin moeglich."
            try:
                pyads = _import_pyads()
                plc_type = _get_pyads_type(data_type)
                if plc_type is None:
                    return False, f"Nicht unterstuetzter Typ: {data_type}"

                attr = pyads.NotificationAttrib(
                    length=_get_type_size(data_type),
                    trans_mode=pyads.constants.ADSTRANS_SERVERCYCLE,
                    max_delay=self.notification_cycle_ms,
                    cycle_time=self.notification_cycle_ms,
                )

                plc_ref = self._plc

                registered_handle = [None]

                def _callback(notification, _name, sym=symbol, pt=plc_type):
                    try:
                        handle, timestamp, value = plc_ref.parse_notification(notification, pt)
                        ts = datetime.now()
                        if self.on_value_changed:
                            self.on_value_changed(sym, value, ts)
                    except Exception as cb_err:
                        # Falsche Symbolgroesse/Typzuordnung nicht endlos wiederholen.
                        # Notification nach dem ersten Dekodierfehler entfernen.
                        if sym not in self._notification_error_reported:
                            self._notification_error_reported.add(sym)
                            logger.warning("Notification-Callback Fehler %s: %s", sym, cb_err)
                        bad_handle = registered_handle[0]
                        if bad_handle is not None:
                            try:
                                plc_ref.del_device_notification(bad_handle)
                            except Exception:
                                pass
                            self._notification_handles.pop(sym, None)

                handle, _ = self._plc.add_device_notification(symbol, attr, _callback)
                registered_handle[0] = handle
                self._notification_handles[symbol] = handle
                logger.info("Notification registriert: %s (Handle %s)", symbol, handle)
                return True, ""
            except Exception as e:
                logger.error("Notification-Fehler %s: %s", symbol, e)
                return False, str(e)

    def stop_notification(self, symbol: str) -> None:
        with self._lock:
            self._stop_notification_locked(symbol)

    def stop_all_notifications(self) -> None:
        with self._lock:
            self._stop_all_notifications_locked()

    def _stop_notification_locked(self, symbol: str) -> None:
        handle = self._notification_handles.pop(symbol, None)
        if handle is not None and self._plc is not None:
            try:
                self._plc.del_device_notification(handle)
                logger.info("Notification entfernt: %s", symbol)
            except Exception as e:
                logger.warning("Fehler beim Entfernen der Notification %s: %s", symbol, e)

    def _stop_all_notifications_locked(self) -> None:
        for symbol in list(self._notification_handles.keys()):
            self._stop_notification_locked(symbol)
